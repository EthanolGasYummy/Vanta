local function w_toggle(it,x,y,w)
  local top=26; local v=cfg[it.id]
  if inside(x,y,w,top) and ui.m.click and interactable() then cfg[it.id]=not v; ui.m.click=false end
  tmid(x,y,top,it.label, a(theme.text,0.9),13)
  local pw,ph=32,16; local px,py=x+w-pw,y+(top-ph)*0.5
  local rv=approach("tg"..it.id, v and 1 or 0, 16)
  draw.RectFilled(px,py,pw,ph, a(mix(theme.field,theme.accent,rv),1), ph*0.5)
  draw.CircleFilled(px+3+(ph-6)*0.5+(pw-ph)*rv, py+ph*0.5, (ph-6)*0.5, a({1,1,1,1},1),20)
  return top
end
local function w_slider(it,x,y,w)
  local top=34; local v=cfg[it.id]
  tmid(x,y,16,it.label, a(theme.sub,1),13)
  local disp=string.format("%.0f",v)..(it.suf and (" "..it.suf) or ""); local dw=ts(disp,12)
  draw.Text(x+w-dw,y+2,disp, a(theme.text,1),12)
  local ty2,th=y+21,5
  draw.RectFilled(x,ty2,w,th, a(theme.rail,1), th*0.5)
  local f=clamp((v-it.min)/(it.max-it.min),0,1); local fill=approach("sl"..it.id,f,18)
  draw.RectFilled(x,ty2,w*fill,th, a(mix(theme.accent,theme.accent2,0.5),1), th*0.5)
  draw.CircleFilled(x+w*fill,ty2+th*0.5,5, a({1,1,1,1},1),20)
  if inside(x,y,w,top) and ui.m.click and not ui.drag and interactable() then ui.drag={k="slider",id=it.id,x=x,w=w,min=it.min,max=it.max} end
  if ui.drag and ui.drag.k=="slider" and ui.drag.id==it.id then
    if ui.m.down then cfg[it.id]=math.floor(it.min+clamp((ui.m.x-x)/w,0,1)*(it.max-it.min)+0.5) else ui.drag=nil end
