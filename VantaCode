local SILENT_BONE={"head","torso","hip1"}
local silent_hook=false
local silent_track=nil
local SILENT_VK=0x01

local function rfn(pascal,snake) return raycast[pascal] or raycast[snake] end
local R_enable  = rfn("EnableSilentHook","enable_silent_hook")
local R_active  = rfn("IsSilentHookActive","is_silent_hook_active")
local R_set     = rfn("SetSilentTarget","set_silent_target")
local R_track   = rfn("TrackSilentTarget","track_silent_target")
local R_clear   = rfn("ClearSilentTarget","clear_silent_target")
local R_stop    = rfn("StopSilentTracking","stop_silent_tracking")
local R_disable = rfn("DisableSilentHook","disable_silent_hook")

local function silent_release()
  if R_stop then pcall(R_stop) end
  if R_clear then pcall(R_clear) end
end

local function silent_send(origin, dir)
  if silent_track==nil then silent_track = type(R_track)=="function" end
  if silent_track then
    return (pcall(function() R_track(origin, dir, SILENT_VK) end))
  end
  if R_set then return (pcall(function() R_set(origin, dir) end)) end
  return false
end

local function silent_enable()
  local active=false
  pcall(function() if R_active then active=R_active()==true end end)
  if active then silent_hook=true; return true end
  local ok=false; pcall(function() if R_enable then ok=R_enable() end end)
  silent_hook = ok==true
  return silent_hook
end
local function run_silent()
  if not cfg.silent_on then
    if silent_hook then silent_release(); if R_disable then pcall(R_disable) end; silent_hook=false end
    return
  end
  if not silent_hook and not silent_enable() then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5

  if cfg.silent_vis then draw.Circle(cx,cy,cfg.silent_fov,a(col.c_silent,0.45),64,1) end
  if not cfg.silent_always and not ekey(bind.silent_key or 0x02) then
    silent_release(); return
  end
  local origin = shoot_origin()
  if not origin then silent_release(); return end
  local bone=SILENT_BONE[cfg.silent_bone] or "head"
  local best,bd,bestv,bsx,bsy=nil,cfg.silent_fov,nil,nil,nil
  for _,p in ipairs(vm_players) do
    local b=(not (cfg.silent_team and p.friend)) and (p.bones[bone] or p.bones.head or p.bones.torso) or nil
    if b then
      local sx,sy,v=W2S(b.x,b.y,b.z)
