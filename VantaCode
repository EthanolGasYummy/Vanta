end
local function box2d(bb)
  local mnx,mny,mxx,mxy,vis=1e9,1e9,-1e9,-1e9,false
  local C={{bb[1],bb[2],bb[3]},{bb[4],bb[2],bb[3]},{bb[1],bb[5],bb[3]},{bb[4],bb[5],bb[3]},{bb[1],bb[2],bb[6]},{bb[4],bb[2],bb[6]},{bb[1],bb[5],bb[6]},{bb[4],bb[5],bb[6]}}
  for i=1,8 do local sx,sy,v=W2S(C[i][1],C[i][2],C[i][3]); if v then vis=true; if sx<mnx then mnx=sx end; if sy<mny then mny=sy end; if sx>mxx then mxx=sx end; if sy>mxy then mxy=sy end end end
  if not vis then return nil end
  return mnx,mny,mxx,mxy
end
local function cam_dist(x,y,z) local cam=camera.GetPosition(); if not cam then return 0 end return math.sqrt((cam.X-x)^2+(cam.Y-y)^2+(cam.Z-z)^2) end
local function offscreen_dir(wx,wy,wz)
  local cam=camera.GetPosition(); local look=camera.GetLookVector(); if not cam or not look then return nil end
  local dx,dy,dz=wx-cam.X,wy-cam.Y,wz-cam.Z
  local rx,ry,rz=-look.Z,0,look.X; local rl=math.sqrt(rx*rx+rz*rz); if rl<1e-6 then rl=1e-6 end rx,rz=rx/rl,rz/rl
  local ux=ry*look.Z-rz*look.Y; local uy=rz*look.X-rx*look.Z; local uz=rx*look.Y-ry*look.X
  local sxp=dx*rx+dy*ry+dz*rz; local syp=dx*ux+dy*uy+dz*uz
  return ATAN2(-syp,sxp)
end

local aim_lock=nil
local function run_aimbot()
  if not cfg.aim_on then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  if cfg.aim_fovcircle then draw.Circle(cx,cy,cfg.aim_fov,a(col.c_fov,0.5),64,1) end
  if not ekey(bind.aim_key or 0x02) then aim_lock=nil; return end
  local bone=AIM_BONE[cfg.aim_bone] or "head"
  local function cand_for(p)
    if cfg.aim_team and p.friend then return nil end
    if cfg.aim_bone==4 then
      local c,md=nil,1e9
      for _,bn in ipairs({"head","torso","hip1"}) do local b=p.bones[bn]
        if b then local sx,sy,v=W2S(b.x,b.y,b.z); if v then local d=(sx-cx)^2+(sy-cy)^2; if d<md then md=d; c={sx=sx,sy=sy,b=b,p=p} end end end
      end
      if c then c.d=math.sqrt(md) end
      return c
    else
      local b=p.bones[bone]
      if b then local sx,sy,v=W2S(b.x,b.y,b.z); if v then return {sx=sx,sy=sy,b=b,p=p,d=math.sqrt((sx-cx)^2+(sy-cy)^2)} end end
    end
    return nil
  end
  local function score(c)
    local m=cfg.aim_priority or 1
    if m==2 then return cam_dist(c.b.x,c.b.y,c.b.z)
    elseif m==3 then return (c.p.hp or 100)*1e4 + c.d
    else return c.d end
  end
  local best=nil
  if cfg.aim_sticky and aim_lock then
    for _,p in ipairs(vm_players) do
      if p.name==aim_lock then local c=cand_for(p); if c and c.d<=cfg.aim_fov then best=c end; break end
    end
  end
  if not best then
    local bs=1e18
    for _,p in ipairs(vm_players) do
      local c=cand_for(p)
      if c and c.d<=cfg.aim_fov then local s=score(c); if s<bs then bs=s; best=c end end
    end
    if cfg.aim_drone then
      for _,d in ipairs(drone_cache) do
        local sx,sy,v=W2S(d.x,d.y,d.z)
        if v then local dd=math.sqrt((sx-cx)^2+(sy-cy)^2)
          if dd<=cfg.aim_fov then local c={sx=sx,sy=sy,b=d,p={name="Drone"},d=dd}; local s=score(c); if s<bs then bs=s; best=c end end
        end
      end
    end
  end
  if best then
    aim_lock=best.p.name
    if cfg.aim_highlight then
      local hc=a(col.c_fov,1)
      draw.Circle(best.sx,best.sy,10,hc,20,1.5)
      draw.Line(best.sx-14,best.sy,best.sx-8,best.sy,hc,1.5); draw.Line(best.sx+8,best.sy,best.sx+14,best.sy,hc,1.5)
      draw.Line(best.sx,best.sy-14,best.sx,best.sy-8,hc,1.5); draw.Line(best.sx,best.sy+8,best.sx,best.sy+14,hc,1.5)
    end
    local aimx,aimy=best.sx,best.sy
    if cfg.aim_pred and best.p.ent then
      local vv; pcall(function() vv=best.p.ent.AssemblyLinearVelocity end)
      if not vv then pcall(function() vv=best.p.ent.Velocity end) end
      if vv then local t=(cfg.aim_predamt or 0)/100
        local nx,ny,nv=W2S(best.b.x+(vv.X or 0)*t, best.b.y+(vv.Y or 0)*t, best.b.z+(vv.Z or 0)*t)
        if nv then aimx,aimy=nx,ny end
      end
    end
    local sm=math.max(1,cfg.aim_smooth)
    local f=clamp((_dt*60)/sm,0,1)
    pcall(input.MoveMouse,(aimx-cx)*f,(aimy-cy)*f)
  else
    aim_lock=nil
  end
end

