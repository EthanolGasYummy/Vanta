  for i=0,steps-1 do draw.RectFilled(x+i*sw,y,sw+1,h,mix(c1,c2,i/(steps-1)),0) end end
local function picker_draw()
  local p=ui.picker; if not p then return end
  if p.combo then
    local ph=#p.items*24+6
    if ui.m.click then if inside(p.x,p.y,p.w,ph) then local idx=math.floor((ui.m.y-p.y-3)/24)+1; if idx>=1 and idx<=#p.items then cfg[p.combo]=idx end end ui.picker=nil; ui.m.click=false end
    draw.RectFilled(p.x,p.y,p.w,ph, a(theme.panel_hi,1),6); draw.Rect(p.x,p.y,p.w,ph,a(theme.accent,0.5),6,1)
    for i,item in ipairs(p.items) do local iy=p.y+3+(i-1)*24; local hot=inside(p.x,iy,p.w,24)
      if hot then draw.RectFilled(p.x+2,iy,p.w-4,24,a(theme.accent,0.2),4) end
      tmid(p.x+10,iy,24,item, a(theme.text, hot and 1 or 0.8),12) end
    return
  end
  local x,y=p.x,p.y; local w,h=230,196
  if ui.m.click and not inside(x,y,w,h) then ui.picker=nil; ui.m.click=false; return end
  draw.RectFilled(x,y,w,h, a(theme.panel_hi,1),8); draw.Rect(x,y,w,h,a(theme.accent,0.5),8,1)
  local pad=12; local svx,svy=x+pad,y+pad; local svw,svh=w-pad*2-26,120
  local huecol=hsv(p.h,1,1)
  grad_h(svx,svy,svw,svh,{1,1,1,1},huecol,20)
  for i=0,19 do draw.RectFilled(svx,svy+i*(svh/20),svw,svh/20+1,{0,0,0,i/19},0) end
  draw.Rect(svx,svy,svw,svh,a(theme.line,1),0,1)
