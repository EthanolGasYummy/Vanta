      end
    end
  end
  if not (best and bestv) then silent_release(); return end
  local ok,dir=pcall(function() return bestv-origin end)
  if not ok or not dir then silent_release(); return end

  local mag; pcall(function() mag=dir.Magnitude end)
  if not mag or mag<0.05 then silent_release(); return end
  if not silent_send(origin, dir) then silent_release(); return end

  if cfg.silent_vis and bsx then
