                vm_players[#vm_players+1]={bones=bones,aabb={mnx,mny,mnz,mxx,mxy,mxz},hp=rec.hp or 100,mhp=rec.mhp or 100,name=rec.name,ent=rec.ent,tool=rec.tool,friend=friend}
              end
