local function serialize()
  local parts={}
  for k,v in pairs(cfg) do parts[#parts+1]="v:"..k.."="..(type(v)=="boolean" and (v and "1" or "0") or tostring(v)) end
  for k,v in pairs(bind) do parts[#parts+1]="b:"..k.."="..tostring(v) end
  for k,v in pairs(col) do parts[#parts+1]="c:"..k.."="..v[1]..","..v[2]..","..v[3]..","..(v[4] or 1) end
  return table.concat(parts,"\n")
end
local function deserialize(s)
  for line in s:gmatch("[^\n]+") do local pfx,k,val=line:match("^(%a):([^=]+)=(.+)$")
    if pfx=="v" then if cfg[k]~=nil then if type(cfg[k])=="boolean" then cfg[k]=(val=="1") else cfg[k]=tonumber(val) or cfg[k] end end
    elseif pfx=="b" then bind[k]=tonumber(val) or bind[k]
    elseif pfx=="c" then local r,g,b,al=val:match("([^,]+),([^,]+),([^,]+),([^,]+)"); if r then col[k]={tonumber(r),tonumber(g),tonumber(b),tonumber(al)} end end
  end
end
